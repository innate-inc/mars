# Mars software workspace configuration
#
# The launcher defaults to sibling repositories living next to `mars/`:
#   ../innate-os
#   ../innate-sim
#   ../innate-cloud-agent
#
# Only set the repo paths below if your checkout lives somewhere else.

# Optional overrides for non-standard checkout locations
# MARS_INNATE_OS_REPO=/absolute/path/to/innate-os
# MARS_INNATE_SIM_REPO=/absolute/path/to/innate-sim
# MARS_INNATE_CLOUD_AGENT_DIR=/absolute/path/to/innate-cloud-agent

# Cloud agent modes:
#   hosted       -> use Innate's hosted cloud agent (default)
#   local-image  -> run a local container image defined by MARS_CLOUD_AGENT_IMAGE
#   local-source -> build and run from MARS_INNATE_CLOUD_AGENT_DIR
MARS_CLOUD_AGENT_MODE=hosted

# Required when MARS_CLOUD_AGENT_MODE=local-image
# MARS_CLOUD_AGENT_IMAGE=ghcr.io/your-org/innate-cloud-agent:latest

MARS_CLOUD_AGENT_PORT=8765
MARS_LOCAL_CLOUD_AGENT_SKIP_AUTH=true

# Simulator behavior
MARS_SIM_AUTO_SETUP=true
MARS_SIM_AUTO_BUILD_FRONTEND=true
MARS_SIM_VISUALIZATION=false
MARS_SIM_LOG_MODE=quiet
MARS_SIM_ARGS=--log-everything
ROSBRIDGE_URI=ws://localhost:9090
SIMULATOR_PORT=8000

# OS container behavior
MARS_OS_ALWAYS_BUILD=true

# Mars / Innate runtime configuration forwarded into the OS and optional local cloud agent
INNATE_SERVICE_KEY=
TELEMETRY_URL=https://logs.innate.bot
CARTESIA_VOICE_ID=6ccbfb76-1fc6-48f7-b71d-91ac6298247b
# Brain log formatting inside innate-os:
#   compact       -> [INFO] message
#   message-only  -> message
#   ros-default   -> ROS 2 default formatting
INNATE_BRAIN_LOG_PROFILE=message-only
INNATE_BRAIN_LOG_COLOR=true

# Uncomment to point hosted mode at a non-default remote brain endpoint.
# Leave commented to use the default built into the OS launch files.
# BRAIN_WEBSOCKET_URI=wss://agent-v1.innate.bot

# Local cloud-agent keys
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
BAML_LOG_LEVEL=
BAML_VERBOSE=
BAML_LOG=
ROBOT_TYPE=sim
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_PROJECT_ID=innate-agent
BIGQUERY_TOKEN_LOGS_DATASET_ID=
BIGQUERY_AUTH_DATASET_ID=innate_analytics
